<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
<script>
(() => {
  "use strict";
  const D = JSON.parse(document.getElementById("data").textContent);
  const NS = "http://www.w3.org/2000/svg";
  const nf = new Intl.NumberFormat("en-US");
  const k = (n) => {
    if (n >= 1e6) return (n / 1e6).toFixed(1).replace(/\.0$/, "") + "M";
    if (n >= 1e3) return (n >= 1e5 ? Math.round(n / 1e3) : (n / 1e3).toFixed(1).replace(/\.0$/, "")) + "k";
    return String(Math.round(n));
  };
  const ms = (v) => v == null ? "n/a" : v >= 1000 ? (v / 1000).toFixed(2) + " s" : v >= 10 ? Math.round(v) + " ms" : v.toFixed(2) + " ms";
  const svg = (tag, attrs, parent) => { const n = document.createElementNS(NS, tag); for (const a in attrs) n.setAttribute(a, attrs[a]); if (parent) parent.appendChild(n); return n; };
  const el = (tag, cls, text, parent) => { const n = document.createElement(tag); if (cls) n.className = cls; if (text != null) n.textContent = text; if (parent) parent.appendChild(n); return n; };
  const find = (rows, match) => (rows || []).find((r) => Object.entries(match).every(([key, v]) => r[key] === v));
  const C = { ruby: "var(--s-ruby)", rubySoft: "var(--s-ruby-soft)", go: "var(--s-go)", goSoft: "var(--s-go-soft)", grey: "var(--s-grey)", accent: "var(--ruby)" };

  function niceStep(raw) { const p = 10 ** Math.floor(Math.log10(raw)); const m = raw / p; return (m <= 1 ? 1 : m <= 2 ? 2 : m <= 2.5 ? 2.5 : m <= 5 ? 5 : 10) * p; }
  function ticks(max, count = 4) { const step = niceStep(max / count); const out = []; for (let v = 0; v < max + step * 0.999; v += step) out.push(Math.round(v * 1e6) / 1e6); return out; }

  function tooltip(host) {
    const tip = el("div", "tip", null, host);
    tip.hidden = true;
    return {
      show(x, y, title, rows) {
        tip.textContent = "";
        el("div", "t", title, tip);
        for (const r of rows) {
          const row = el("div", "row", null, tip);
          const key = el("i", r.swatch ? "swatch" : r.dash ? "key dash" : "key", null, row);
          if (r.swatch) key.style.background = r.color; else key.style.borderTopColor = r.color;
          el("span", null, r.label, row);
          el("b", null, r.value, row);
        }
        tip.hidden = false;
        const w = host.clientWidth, tw = tip.offsetWidth, th = tip.offsetHeight;
        let left = x + 16;
        if (left + tw > w) left = Math.max(0, x - tw - 16);
        tip.style.left = left + "px";
        tip.style.top = Math.max(0, y - th / 2) + "px";
      },
      hide() { tip.hidden = true; },
    };
  }

  function legend(fig, items) {
    const box = fig.querySelector(".legend");
    if (!box) return;
    box.textContent = "";
    for (const it of items) {
      const span = el("span", null, null, box);
      const key = el("i", it.swatch ? "swatch" : it.dash ? "key dash" : "key", null, span);
      if (it.swatch) key.style.background = it.color; else key.style.borderTopColor = it.color;
      span.append(it.label);
    }
  }

  function table(fig, headers, rows) {
    const btn = fig.querySelector("button.tbl");
    const wrap = el("div", "tbl-wrap", null, fig);
    wrap.hidden = true;
    const t = el("table", null, null, wrap);
    const head = el("tr", null, null, el("thead", null, null, t));
    headers.forEach((h) => el("th", null, h, head));
    const body = el("tbody", null, null, t);
    rows.forEach((r) => { const tr = el("tr", null, null, body); r.forEach((c, i) => el("td", i ? "num" : null, c, tr)); });
    if (!btn) { wrap.hidden = false; return; }
    btn.setAttribute("aria-expanded", "false");
    btn.addEventListener("click", () => {
      wrap.hidden = !wrap.hidden;
      btn.setAttribute("aria-expanded", String(!wrap.hidden));
      btn.textContent = wrap.hidden ? "Table" : "Hide table";
    });
  }

  function lineChart(fig, spec) {
    if (!fig) return;
    const plot = fig.querySelector(".plot");
    const ref = spec.ref ? [{ label: spec.ref.label, color: C.grey }] : [];
    legend(fig, spec.series.map((s) => ({ label: s.label, color: s.color, dash: s.dash })).concat(ref));
    table(fig, [spec.xName, ...spec.series.map((s) => s.label), ...(spec.ref ? [spec.ref.label] : [])],
      spec.xs.map((x, i) => [spec.xFmt(x), ...spec.series.map((s) => s.values[i] == null ? "n/a" : spec.tableFmt(s.values[i])), ...(spec.ref ? [spec.tableFmt(spec.ref.values[i])] : [])]));
    let lastW = 0;
    const draw = () => {
      const W = Math.round(plot.clientWidth);
      if (!W || W === lastW) return;
      lastW = W;
      plot.textContent = "";
      const H = W < 520 ? 250 : 300;
      const ends = spec.series.filter((s) => s.end);
      const m = { l: 52, r: ends.length ? 70 : 16, t: 14, b: 42 };
      const xs = spec.xs, n = xs.length, iw = W - m.l - m.r, ih = H - m.t - m.b;
      const lx = xs.map((x) => Math.log(x));
      const X = (i) => m.l + (spec.log ? (lx[i] - lx[0]) / (lx[n - 1] - lx[0]) : i / (n - 1)) * iw;
      const all = spec.series.flatMap((s) => s.values).concat(spec.ref && spec.ref.inScale ? spec.ref.values : []).filter((v) => v != null);
      const yt = ticks(Math.max(...all) * 1.05);
      const ymax = yt[yt.length - 1];
      const Y = (v) => m.t + (1 - Math.min(v, ymax) / ymax) * ih;
      const root = svg("svg", { viewBox: `0 0 ${W} ${H}`, height: H, tabindex: 0, role: "img", "aria-label": spec.aria }, plot);
      yt.forEach((v) => {
        svg("line", { x1: m.l, x2: W - m.r, y1: Y(v), y2: Y(v), stroke: v === 0 ? "var(--axis)" : "var(--grid)", "stroke-width": 1, "shape-rendering": "crispEdges" }, root);
        svg("text", { x: m.l - 8, y: Y(v) + 4, "text-anchor": "end" }, root).textContent = spec.yFmt(v);
      });
      xs.forEach((x, i) => { svg("text", { x: X(i), y: H - m.b + 19, "text-anchor": "middle" }, root).textContent = spec.xFmt(x); });
      svg("text", { x: m.l + iw / 2, y: H - 4, "text-anchor": "middle", class: "lab" }, root).textContent = spec.xLabel;
      if (spec.ref) {
        const pts = spec.ref.values.map((v, i) => [X(i), Y(v)]).filter((p, i) => spec.ref.values[i] <= ymax || i === 0);
        svg("polyline", { points: pts.map((p) => p.join(",")).join(" "), fill: "none", stroke: C.grey, "stroke-width": 1.5, "stroke-linecap": "round" }, root);
      }
      for (const s of spec.series) {
        const pts = s.values.map((v, i) => (v == null ? null : [X(i), Y(v)])).filter(Boolean);
        svg("polyline", { points: pts.map((p) => p.join(",")).join(" "), fill: "none", stroke: s.color, "stroke-width": 2, "stroke-linejoin": "round", "stroke-linecap": "round", "stroke-dasharray": s.dash ? "7 5" : "none" }, root);
        pts.forEach((p) => svg("circle", { cx: p[0], cy: p[1], r: 4, fill: s.color, stroke: "var(--surface)", "stroke-width": 2 }, root));
      }
      const placed = [];
      for (const s of ends) {
        const i = s.values.length - 1;
        if (s.values[i] == null) continue;
        const y = Y(s.values[i]);
        if (placed.some((p) => Math.abs(p - y) < 15)) continue;
        placed.push(y);
        svg("text", { x: X(i) + 10, y: y + 4, class: "lab" }, root).textContent = s.end;
      }
      const cross = svg("line", { y1: m.t, y2: m.t + ih, stroke: "var(--axis)", "stroke-width": 1, visibility: "hidden" }, root);
      const hit = svg("rect", { x: m.l - 12, y: 0, width: iw + 24, height: H, fill: "transparent" }, root);
      const tip = tooltip(plot);
      let idx = -1;
      const show = (i, y) => {
        idx = i;
        cross.setAttribute("x1", X(i));
        cross.setAttribute("x2", X(i));
        cross.setAttribute("visibility", "visible");
        const rows = spec.series
          .map((s) => ({ label: s.label, color: s.color, dash: s.dash, v: s.values[i] }))
          .filter((r) => r.v != null)
          .sort((a, b) => b.v - a.v)
          .map((r) => ({ ...r, value: spec.tipFmt(r.v) }));
        if (spec.ref) rows.push({ label: spec.ref.label, color: C.grey, value: spec.tipFmt(spec.ref.values[i]) });
        tip.show(X(i), y ?? m.t + ih / 3, spec.tipTitle(xs[i]), rows);
      };
      const hide = () => { cross.setAttribute("visibility", "hidden"); tip.hide(); };
      hit.addEventListener("pointermove", (e) => {
        const r = root.getBoundingClientRect();
        const px = ((e.clientX - r.left) * W) / r.width;
        let best = 0;
        xs.forEach((_, i) => { if (Math.abs(X(i) - px) < Math.abs(X(best) - px)) best = i; });
        show(best, ((e.clientY - r.top) * H) / r.height);
      });
      hit.addEventListener("pointerleave", hide);
      root.addEventListener("focus", () => show(idx < 0 ? n - 1 : idx));
      root.addEventListener("blur", hide);
      root.addEventListener("keydown", (e) => {
        if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
        e.preventDefault();
        show(Math.max(0, Math.min(n - 1, (idx < 0 ? n - 1 : idx) + (e.key === "ArrowRight" ? 1 : -1))));
      });
    };
    draw();
    if (window.ResizeObserver) new ResizeObserver(draw).observe(plot);
  }

  function bars(fig, rows, opts) {
    if (!fig) return;
    const box = fig.querySelector(".hbars");
    box.textContent = "";
    const totals = rows.filter((r) => !r.group).map((r) => r.segs.reduce((a, s) => a + s.v, 0));
    const max = Math.max(...totals) * (opts.pad || 1.24);
    const tip = tooltip(fig);
    for (const r of rows) {
      if (r.group) { el("div", "hbar group-head", r.group, box); continue; }
      const row = el("div", "hbar", null, box);
      el("div", "lbl", r.label, row);
      const track = el("div", "track", null, row);
      track.tabIndex = 0;
      track.setAttribute("aria-label", `${r.label}: ${opts.fmt(r.segs.reduce((a, s) => a + s.v, 0))}`);
      const total = r.segs.reduce((a, s) => a + s.v, 0);
      let acc = 0;
      r.segs.forEach((s, i) => {
        const seg = el("div", "seg" + (i === r.segs.length - 1 ? " end" : ""), null, track);
        const gap = i ? 2 : 0;
        seg.style.left = `calc(${(acc / max) * 100}% + ${gap}px)`;
        seg.style.width = `max(2px, calc(${(s.v / max) * 100}% - ${gap}px))`;
        seg.style.background = s.c;
        acc += s.v;
      });
      el("div", "v", opts.fmt(total, r), track).style.left = `${(total / max) * 100}%`;
      const show = () => {
        const f = fig.getBoundingClientRect(), t = track.getBoundingClientRect();
        const lines = r.segs.length > 1 || r.segs[0].name ? r.segs.map((s) => ({ label: s.name, color: s.c, swatch: true, value: opts.fmt(s.v) })) : [{ label: opts.unit, color: r.segs[0].c, swatch: true, value: opts.fmt(total) }];
        if (r.note) lines.push({ label: r.note, color: "transparent", swatch: true, value: "" });
        tip.show(t.left - f.left + (t.width * total) / max, t.top - f.top + t.height / 2, r.label, lines);
      };
      track.addEventListener("pointerenter", show);
      track.addEventListener("focus", show);
      track.addEventListener("pointerleave", () => tip.hide());
      track.addEventListener("blur", () => tip.hide());
    }
  }

  const S = D.scaling || [];
  const N = D.notes || {};
  const rps = (rows, impl, workers, route) => { const r = find(rows, { impl, workers, route }); return r ? r.rps : null; };
  const CPUS = [1, 2, 4, 8];
  const cpuFmt = (x) => (x === 8 ? "8 (SMT)" : String(x));
  const reqFmt = (v) => nf.format(Math.round(v)) + " req/s";
  const pctFmt = (v) => (Math.round(v * 10) / 10).toFixed(v >= 10 ? 0 : 1) + "%";
  const NAMES = { "go-std": "Go", "go-jsontext": "Go, jsontext", "ruby-ractor": "Ruby, Ractors", "ruby-fork": "Ruby, 4 forks", "ruby-thread": "Ruby, threads" };
  const COLORS = { "go-std": C.go, "go-jsontext": C.goSoft, "ruby-ractor": C.ruby, "ruby-fork": C.rubySoft, "ruby-thread": C.grey };

  const scaleSpec = (route, series) => ({
    xs: CPUS, xName: "CPUs", xFmt: cpuFmt, xLabel: "logical CPUs given to the gateway", yFmt: k, tipFmt: reqFmt, tableFmt: (v) => nf.format(v),
    tipTitle: (x) => `${cpuFmt(x)} CPU${x > 1 ? "s" : ""}`,
    aria: `Requests per second against CPUs, ${route} route`,
    series: series.map(([impl, label, color, dash, end]) => ({ label, color, dash, end, values: CPUS.map((w) => rps(S, impl, w, route)) })),
  });
  const rubySeries = [["ruby-ractor", "Ruby, Ractors", C.ruby, false, "Ractors"], ["ruby-fork", "Ruby, fork", C.ruby, true, null], ["ruby-thread", "Ruby, threads", C.grey, false, "threads"]];
  lineChart(document.getElementById("fig-scale-raw"), scaleSpec("raw", [["go-std", "Go", C.go, false, "Go"], ...rubySeries]));
  lineChart(document.getElementById("fig-scale-api"), scaleSpec("api", [["go-std", "Go, encoding/json", C.go, false, "Go std"], ["go-jsontext", "Go, jsontext", C.go, true, null], ...rubySeries]));
  lineChart(document.getElementById("fig-scale-hit"), scaleSpec("hit", [["go-std", "Go", C.go, false, "Go"], ...rubySeries]));

  const ROUTE_NAMES = { raw: "Pass-through", api: "API rewrite", hit: "Cache hit" };
  const cpuRows = [];
  for (const route of ["raw", "api", "hit"]) {
    cpuRows.push({ group: ROUTE_NAMES[route] });
    for (const impl of route === "api" ? ["go-std", "go-jsontext", "ruby-ractor"] : ["go-std", "ruby-ractor"]) {
      const r = find(S, { impl, workers: 4, route });
      if (r && r.cpu_us_per_request) cpuRows.push({ label: NAMES[impl], segs: [{ v: r.cpu_us_per_request, c: COLORS[impl] }] });
    }
  }
  bars(document.getElementById("fig-cpu"), cpuRows, { fmt: (v) => v.toFixed(1) + " µs", unit: "CPU" });
  legend(document.getElementById("fig-cpu"), [{ label: "Ruby, Ractors", color: C.ruby, swatch: true }, { label: "Go", color: C.go, swatch: true }, { label: "Go, jsontext", color: C.goSoft, swatch: true }]);
  table(document.getElementById("fig-cpu"), ["Route", "Go µs", "Go jsontext µs", "Ruby µs"], ["raw", "api", "hit"].map((route) => [ROUTE_NAMES[route], ...["go-std", "go-jsontext", "ruby-ractor"].map((impl) => { const r = find(S, { impl, workers: 4, route }); return r && r.cpu_us_per_request ? r.cpu_us_per_request.toFixed(1) : "n/a"; })]));

  const SH = D.sharing || [];
  const shareOrder = ["ruby-ractor", "ruby-thread", "go-std", "ruby-fork"];
  const shareRows = (value, note) => shareOrder.map((impl) => { const r = find(SH, { impl }); return r && { label: NAMES[impl], segs: [{ v: value(r), c: COLORS[impl] }], note: note && note(r) }; }).filter(Boolean);
  const scrapeShare = (r) => r.metrics.scrapes.reduce((a, b) => a + b, 0) / r.metrics.scrapes.length / r.metrics.served * 100;
  bars(document.getElementById("fig-metrics"), shareRows(scrapeShare, (r) => `scrapes ranged ${pctFmt(Math.min(...r.metrics.scrapes) / r.metrics.served * 100)} to ${pctFmt(Math.max(...r.metrics.scrapes) / r.metrics.served * 100)}`), { fmt: pctFmt, unit: "of requests", pad: 1.3 });
  table(document.getElementById("fig-metrics"), ["Workers", "Requests served", "Lowest scrape", "Highest scrape"], shareOrder.map((impl) => { const r = find(SH, { impl }); return r ? [NAMES[impl], nf.format(r.metrics.served), nf.format(Math.min(...r.metrics.scrapes)), nf.format(Math.max(...r.metrics.scrapes))] : null; }).filter(Boolean));
  bars(document.getElementById("fig-limit"), shareRows((r) => r.rate_limit.allowed), { fmt: (v) => nf.format(v), unit: "let through" });
  table(document.getElementById("fig-limit"), ["Workers", "Requests offered", "Let through", "Turned away"], shareOrder.map((impl) => { const r = find(SH, { impl }); return r ? [NAMES[impl], nf.format(r.rate_limit.requests), nf.format(r.rate_limit.allowed), nf.format(r.rate_limit.requests - r.rate_limit.allowed)] : null; }).filter(Boolean));
  bars(document.getElementById("fig-cache"), shareRows((r) => r.cache.upstream_fetches), { fmt: (v) => nf.format(v), unit: "upstream fetches" });
  table(document.getElementById("fig-cache"), ["Workers", "Requests", "Upstream fetches", "Hit rate"], shareOrder.map((impl) => { const r = find(SH, { impl }); return r ? [NAMES[impl], nf.format(r.cache.requests), nf.format(r.cache.upstream_fetches), pctFmt((1 - r.cache.upstream_fetches / r.cache.requests) * 100)] : null; }).filter(Boolean));

  const P = D.profile || [];
  const CATS = [["gateway Ruby code", "Gateway code", C.ruby], ["Ruby core methods", "Ruby core methods", C.rubySoft], ["json extension", "json extension", "var(--ink-2)"], ["IO and syscalls", "IO and syscalls", C.go], ["async and io-event", "async and io-event", C.goSoft], ["garbage collector", "Garbage collector", C.grey]];
  const PROFILES = [["v1", "raw", "First version, pass-through"], ["v1", "api", "First version, JSON route"], ["v2", "raw", "This version, pass-through"], ["v2", "api", "This version, API rewrite"]];
  bars(document.getElementById("fig-profile"), PROFILES.map(([version, route, label]) => { const r = find(P, { version, route }); return r && { label, segs: CATS.filter(([key]) => r.shares[key]).map(([key, name, c]) => ({ v: r.shares[key], c, name })) }; }).filter(Boolean), { fmt: pctFmt, unit: "of samples", pad: 1.0 });
  legend(document.getElementById("fig-profile"), CATS.map(([, name, color]) => ({ label: name, color, swatch: true })));
  table(document.getElementById("fig-profile"), ["Profile", ...CATS.map(([, name]) => name)], PROFILES.map(([version, route, label]) => { const r = find(P, { version, route }); return r ? [label, ...CATS.map(([key]) => pctFmt(r.shares[key] || 0))] : null; }).filter(Boolean));

  const sys = N.syscalls_per_request || [];
  const sysKinds = [["read", "read", C.grey], ["write", "write", "var(--axis)"], ["writev", "writev", "var(--axis)"], ["fcntl", "fcntl", C.accent]];
  bars(document.getElementById("fig-sys"), sys.map((r) => ({ label: r.label, segs: sysKinds.filter(([key]) => r[key]).map(([key, name, c]) => ({ v: r[key], c, name })) })), { fmt: (v) => String(Math.round(v * 10) / 10), unit: "syscalls", pad: 1.15 });
  legend(document.getElementById("fig-sys"), [{ label: "read", color: C.grey, swatch: true }, { label: "write or writev", color: "var(--axis)", swatch: true }, { label: "fcntl", color: C.accent, swatch: true }]);
  table(document.getElementById("fig-sys"), ["Version", "read", "write", "writev", "fcntl", "total"], sys.map((r) => [r.label, r.read || 0, r.write || 0, r.writev || 0, r.fcntl || 0, (r.read || 0) + (r.write || 0) + (r.writev || 0) + (r.fcntl || 0)].map(String)));

  const heap = N.heap_init_sweep || [];
  bars(document.getElementById("fig-heap"), heap.map((r) => ({ label: r.label, segs: [{ v: r.trim_rps, c: r.bytes === 2621440 ? C.ruby : C.grey }], note: `${nf.format(r.gcs)} GCs per Ractor` })), { fmt: k, unit: "req/s" });
  table(document.getElementById("fig-heap"), ["Starting heap", "JSON req/s", "Pass-through req/s", "GCs per Ractor", "GC ms per Ractor", "Heap pages"], heap.map((r) => [r.label, nf.format(r.trim_rps), nf.format(r.raw_rps), nf.format(r.gcs), nf.format(r.gc_ms), nf.format(r.pages)]));

  const T = D.tuning || [];
  const ladder = [["ruby-stock", "Stock master", C.grey], ["ruby-heap", "+ 2.5 MB Ractor heap", C.grey], ["ruby-leaky", "+ io hooks removed", C.grey], ["ruby-ractor", "+ GC timer (final)", C.ruby], ["ruby-interp", "final, interpreter", C.rubySoft], ["ruby-zjit", "final, ZJIT", C.rubySoft]];
  const tuneRows = [];
  for (const route of ["api", "raw", "hit"]) {
    tuneRows.push({ group: ROUTE_NAMES[route] });
    for (const [impl, label, c] of ladder) { const r = find(T, { impl, route }); if (r) tuneRows.push({ label, segs: [{ v: r.rps, c }] }); }
  }
  bars(document.getElementById("fig-tuning"), tuneRows, { fmt: k, unit: "req/s" });
  table(document.getElementById("fig-tuning"), ["Configuration", "API req/s", "Pass-through req/s", "Cache hit req/s"], ladder.map(([impl, label]) => [label, ...["api", "raw", "hit"].map((route) => { const r = find(T, { impl, route }); return r ? nf.format(r.rps) : "n/a"; })]));

  const V = D.versions || [];
  const vRows = [];
  for (const route of ["api", "raw", "hit"]) {
    for (const w of [1, 4]) {
      vRows.push({ group: `${ROUTE_NAMES[route]}, ${w} Ractor${w > 1 ? "s" : ""}` });
      [["ruby406-ractor", "4.0.6", C.grey], ["ruby-stock", "master, stock settings", C.rubySoft], ["ruby-ractor", "master, tuned", C.ruby]].forEach(([impl, label, c]) => { const v = rps(V, impl, w, route); if (v != null) vRows.push({ label, segs: [{ v, c }] }); });
    }
  }
  bars(document.getElementById("fig-versions"), vRows, { fmt: k, unit: "req/s" });
  legend(document.getElementById("fig-versions"), [{ label: "4.0.6", color: C.grey, swatch: true }, { label: "master, stock", color: C.rubySoft, swatch: true }, { label: "master, tuned", color: C.ruby, swatch: true }]);
  table(document.getElementById("fig-versions"), ["Route and workers", "4.0.6 Ractors", "4.0.6 fork", "master stock", "master tuned"], ["api", "raw", "hit"].flatMap((route) => [1, 4].map((w) => [`${ROUTE_NAMES[route]}, ${w}`, ...["ruby406-ractor", "ruby406-fork", "ruby-stock", "ruby-ractor"].map((impl) => { const v = rps(V, impl, w, route); return v == null ? "n/a" : nf.format(v); })])));

  const CC = D.concurrency || [];
  const CONNS = [64, 256, 1024, 4096, 10000];
  const concSeries = [["go-std", 4, "Go, 4 cores", C.go, false, "Go 4"], ["ruby-ractor", 4, "Ruby, 4 Ractors", C.ruby, false, "Ruby 4"], ["go-std", 1, "Go, 1 core", C.go, true, null], ["ruby-ractor", 1, "Ruby, 1 Ractor", C.ruby, true, "Ruby 1"]];
  const concBase = { xs: CONNS, log: true, xName: "Connections", xFmt: (x) => (x >= 1000 ? x / 1000 + "k" : String(x)), xLabel: "open keep-alive connections", tipTitle: (x) => `${nf.format(x)} connections` };
  lineChart(document.getElementById("fig-conc-rps"), { ...concBase, yFmt: k, tipFmt: reqFmt, tableFmt: (v) => nf.format(v), aria: "Requests per second against open connections with 50 ms upstream latency",
    series: concSeries.map(([impl, w, label, color, dash, end]) => ({ label, color, dash, end, values: CONNS.map((c) => { const r = find(CC, { impl, workers: w, connections: c }); return r ? r.rps : null; }) })),
    ref: { label: "20 req/s per connection", values: CONNS.map((c) => c * 20), inScale: true } });
  lineChart(document.getElementById("fig-conc-p99"), { ...concBase, yFmt: (v) => Math.round(v) + " ms", tipFmt: ms, tableFmt: ms, aria: "p99 latency against open connections with 50 ms upstream latency",
    series: concSeries.map(([impl, w, label, color, dash, end]) => ({ label, color, dash, end, values: CONNS.map((c) => { const r = find(CC, { impl, workers: w, connections: c }); return r ? r.latency_ms["99"] : null; }) })) });

  const L = D.latency || [];
  const latFig = document.getElementById("fig-latency");
  if (latFig && L.length) {
    const t = latFig.querySelector("table");
    const head = el("tr", null, null, el("thead", null, null, t));
    ["Route and rate", "Implementation", "Achieved req/s", "p50", "p90", "p99", "p99.9", "p99.99"].forEach((h) => el("th", null, h, head));
    const body = el("tbody", null, null, t);
    const order = ["go-std", "go-jsontext", "ruby-ractor", "ruby-fork"];
    const rows = L.slice().sort((a, b) => (a.route === b.route ? 0 : a.route === "raw" ? -1 : 1) || a.rate - b.rate || order.indexOf(a.impl) - order.indexOf(b.impl));
    let last = "";
    for (const r of rows) {
      const group = `${r.route === "api" ? "API rewrite" : "Pass-through"} at ${k(r.rate)}/s`;
      const tr = el("tr", null, null, body);
      el("td", null, group === last ? "" : group, tr);
      last = group;
      el("td", null, NAMES[r.impl] || r.impl, tr);
      el("td", "num", nf.format(r.rps), tr);
      ["50", "90", "99", "99.9", "99.99"].forEach((p) => el("td", "num", ms(r.latency_ms[p]), tr));
    }
  }

  const loadSeries = [["ruby-ractor", "Ruby, Ractors", C.ruby, false, "Ractors"], ["ruby-fork", "Ruby, fork", C.ruby, true, "fork"], ["go-std", "Go", C.go, false, "Go"]];
  lineChart(document.getElementById("fig-mem-load"), { xs: CPUS, xName: "Workers", xFmt: cpuFmt, xLabel: "workers (Go: GOMAXPROCS)", yFmt: (v) => Math.round(v) + " MB", tipFmt: (v) => Math.round(v) + " MB", tableFmt: (v) => (Math.round(v * 10) / 10).toFixed(1) + " MB", tipTitle: (x) => `${cpuFmt(x)} workers`, aria: "Peak memory against worker count under the API load",
    series: loadSeries.map(([impl, label, color, dash, end]) => ({ label, color, dash, end, values: CPUS.map((w) => { const r = find(S, { impl, workers: w, route: "api" }); return r ? r.peak_pss_kb / 1024 : null; }) })) });

  const I = D.idle || [];
  const idleImpls = [["go-std", "Go", C.go], ["ruby-ractor", "Ruby, Ractors", C.ruby], ["ruby-fork", "Ruby, fork", C.rubySoft], ["ruby-thread", "Ruby, threads", C.grey]];
  const perConn = (impl) => { const a = find(I, { impl, connections: 0 }), b = find(I, { impl, connections: 10000 }); return a && b ? (b.pss_kb - a.pss_kb) / 10000 : null; };
  bars(document.getElementById("fig-mem-idle"), idleImpls.filter(([impl]) => perConn(impl) != null).map(([impl, label, c]) => ({ label, segs: [{ v: perConn(impl), c }] })), { fmt: (v) => v.toFixed(1) + " KB", unit: "per connection" });
  table(document.getElementById("fig-mem-idle"), ["Implementation", "PSS, idle", "PSS, 1,000 held", "PSS, 10,000 held", "KB per connection"], idleImpls.map(([impl, label]) => { const at = (c) => { const r = find(I, { impl, connections: c }); return r ? Math.round(r.pss_kb / 1024) + " MB" : "n/a"; }; const p = perConn(impl); return [label, at(0), at(1000), at(10000), p == null ? "n/a" : p.toFixed(1)]; }));

  const CA = D.caching || [];
  const cacheImpls = [["ruby-ractor", "Ruby, Ractors", C.ruby], ["ruby-leaky", "Ruby, Ractors, no GC timer", C.accent], ["ruby-fork", "Ruby, fork", C.rubySoft], ["ruby-thread", "Ruby, threads", C.grey], ["go-std", "Go", C.go], ["spinel", "Spinel", C.goSoft]];
  const cacheNames = Object.fromEntries(cacheImpls.map(([impl, label]) => [impl, label]));
  const cacheRows = [];
  for (const w of [4, 8]) {
    cacheRows.push({ group: `${w} workers` });
    for (const [impl, label, c] of cacheImpls) { const r = find(CA, { impl, workers: w }); if (r) cacheRows.push({ label, segs: [{ v: r.pss_kb_peak / 1024, c }], note: `${nf.format(r.upstream_fetches)} fetches` }); }
  }
  bars(document.getElementById("fig-mem-cache"), cacheRows, { fmt: (v) => nf.format(Math.round(v)) + " MB", unit: "peak PSS" });
  table(document.getElementById("fig-mem-cache"), ["Implementation", "Workers", "Peak PSS", "Upstream fetches", "p99"], CA.map((r) => [cacheNames[r.impl] || r.impl, String(r.workers), nf.format(Math.round(r.pss_kb_peak / 1024)) + " MB", nf.format(r.upstream_fetches), ms(r.latency_ms["99"])]));

  const RW = N.rewrite_us || [];
  const rwRows = [];
  for (const [key, title] of [["fields", "Four fields of each object"], ["document", "The whole document"]]) {
    rwRows.push({ group: title });
    RW.slice().sort((a, b) => a[key] - b[key]).forEach((r) => rwRows.push({ label: r.label, segs: [{ v: r[key], c: r.lang === "ruby" ? C.ruby : C.go }] }));
  }
  bars(document.getElementById("fig-rewrite"), rwRows, { fmt: (v) => v.toFixed(1) + " µs", unit: "per document" });
  legend(document.getElementById("fig-rewrite"), [{ label: "Ruby", color: C.ruby, swatch: true }, { label: "Go", color: C.go, swatch: true }]);
  table(document.getElementById("fig-rewrite"), ["Implementation", "Four fields µs", "Whole document µs"], RW.map((r) => [r.label, r.fields.toFixed(1), r.document.toFixed(1)]));

  const J = (N.json_trim_us || []).slice().sort((a, b) => a.us - b.us);
  bars(document.getElementById("fig-json"), J.map((r) => ({ label: r.label, segs: [{ v: r.us, c: r.lang === "ruby" ? C.ruby : C.go }], note: r.note })), { fmt: (v) => v.toFixed(1) + " µs", unit: "per trim" });
  legend(document.getElementById("fig-json"), [{ label: "Ruby", color: C.ruby, swatch: true }, { label: "Go", color: C.go, swatch: true }]);
  table(document.getElementById("fig-json"), ["Library", "µs per trim", "Allocations"], J.map((r) => [r.label, r.us.toFixed(1), r.allocs == null ? "n/a" : nf.format(r.allocs)]));

  const tabs = [...document.querySelectorAll('#code [role="tab"]')];
  const select = (tab) => {
    tabs.forEach((t) => {
      const on = t === tab;
      t.setAttribute("aria-selected", String(on));
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute("aria-controls")).hidden = !on;
    });
  };
  tabs.forEach((tab, i) => {
    tab.addEventListener("click", () => select(tab));
    tab.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
      e.preventDefault();
      const next = tabs[(i + (e.key === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length];
      select(next);
      next.focus();
    });
  });

  if (window.hljs) {
    document.querySelectorAll("#code code").forEach((code) => {
      const ln = [...code.querySelectorAll(".ln")];
      const html = window.hljs.highlight(ln.map((l) => l.textContent).join("\n"), { language: code.dataset.lang, ignoreIllegals: true }).value.split("\n");
      if (html.length === ln.length) ln.forEach((l, i) => { l.innerHTML = html[i]; });
    });
  }
})();
</script>
